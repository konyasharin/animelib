import { useQuery } from '@tanstack/react-query';

import { trpc } from './trpc';
{{/if}}

export function App() {
{{#if withTrpc}}
  const health = useQuery(trpc.health.check.queryOptions());

{{/if}}
  return (
    <main>
      <h1>{{ name }}</h1>
{{#if withTrpc}}
      <p>API: {health.isSuccess ? 'ok' : 'недоступен'}</p>
{{/if}}
    </main>
  );
}
