{
  "name": "animelib",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint . --max-warnings 0",
    "fix": "turbo run fix && eslint . --fix",
    "check-types": "turbo run check-types && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\" --ignore-path .gitignore",
    "gen": "turbo gen",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.10.9",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
