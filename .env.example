# Postgres в облаке (Neon / Supabase / RDS / Prisma Postgres).
# Строка для приложения — через пулер, если он есть.
DATABASE_URL="postgresql://user:password@host:5432/app?sslmode=require"

# Прямое подключение — им ходит prisma CLI (миграции): пулеры вроде pgbouncer
# не умеют DDL. Если пулера нет, оставьте пустым — возьмётся DATABASE_URL.
DIRECT_DATABASE_URL=""

# Адрес tRPC-сервера для Vite-приложений
VITE_API_URL="http://localhost:2022"

# Порт api-example
PORT="2022"
